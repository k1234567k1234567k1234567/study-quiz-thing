# Copy this file to .env and paste your free key from https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: pick other models from the catalog (the vision one must accept images).
# You can list several separated by commas; the next one is tried if NVIDIA says a model is retired.
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# PORT=3000

# Optional but recommended: a free Groq key (https://console.groq.com) makes cards and quizzes much faster.
# Text goes to Groq first and falls back to NVIDIA; photos always use NVIDIA, so keep the NVIDIA key too.
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
